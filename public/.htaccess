# SiriGro – Verpex cPanel Apache / LiteSpeed Configuration
# Place inside public_html/ along with the compiled static assets.

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS first (satisfies HSTS & Internet.nl single-hop redirect requirement)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Optional: canonicalize www.sirigro.com -> sirigro.com on HTTPS
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3. Allow .well-known verification files and existing static files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route SPA paths (/expertise, /about, /contact) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Remove server/PHP disclosure headers flagged by UpGuard
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Strict Transport Security (2 years, preload-ready)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" env=HTTPS

  # Clickjacking, MIME-sniffing & Referrer protection
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Strict Content Security Policy (passes all 10 Internet.nl CSP checks; zero unsafe-inline / data:)
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; object-src 'none'; img-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests"
</IfModule>

# Ensure RFC 9116 security.txt serves as UTF-8 plain text
<Files "security.txt">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
  </IfModule>
</Files>

# Block direct HTTP access to hidden files except .well-known and .htaccess itself
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Long-lived immutable caching for hashed Vite assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>
